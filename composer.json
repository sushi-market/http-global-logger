{
  "name": "sushi-market/http-logger",
  "description": "Laravel incoming HTTP request and response logger",
  "keywords": ["laravel", "http", "logger"],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {"psr-4": {"DF\\HttpLogger\\": "src/"}},
  "autoload-dev": {"psr-4": {"DF\\HttpLogger\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["DF\\HttpLogger\\HttpLoggerServiceProvider"]}},
  "scripts": {"test": "phpunit"}
}
